# Base de datos (SQLite para desarrollo local; usar postgresql://... en producción)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
NEXTAUTH_URL="http://localhost:3000"

# Clave de cifrado (AES-256-GCM) para el token de Nubox y el token de
# Duemint guardados en la base de datos. Debe ser una clave de 32 bytes en
# base64. Generar una nueva por entorno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NUNCA reutilizar el valor de ejemplo de abajo en un entorno real.
APP_ENCRYPTION_KEY="XxdEJkurzCn0IkbA91ZwdP4zalkwPIbgxVPiBvXi6UE="

# Integración Nubox (facturador: compras y ventas)
# NUBOX_MODE=mock -> usa datos de ejemplo, no llama a Nubox
# NUBOX_MODE=live -> usa NuboxApiClient contra la API real (sin validar todavía, ver README)
NUBOX_MODE="mock"
NUBOX_API_BASE_URL="https://api.nubox.com/v1"

# Integración Duemint (opcional: solo estado de pago de ventas)
# DUEMINT_MODE=mock -> usa datos de ejemplo, no llama a Duemint
# DUEMINT_MODE=live -> usa DuemintApiClient contra la API real
DUEMINT_MODE="mock"
DUEMINT_API_BASE_URL="https://api.duemint.com/api/v1"
