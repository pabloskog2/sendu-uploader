# Base de datos (SQLite para desarrollo local; usar postgresql://... en producción)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
NEXTAUTH_URL="http://localhost:3000"

# Integración SII (compras / egresos)
# SII_MODE=mock -> usa datos de ejemplo (la integración real está pendiente, ver src/lib/sii-client.ts)
# SII_MODE=live -> usa SiiRcvClient
SII_MODE="mock"

# Integración Duemint (ventas / cobros)
# DUEMINT_MODE=mock -> usa datos de ejemplo, no llama a Duemint
# DUEMINT_MODE=live -> usa DuemintApiClient contra la API real
DUEMINT_MODE="mock"
DUEMINT_API_BASE_URL="https://api.duemint.com/api/v1"
