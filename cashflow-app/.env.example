# Base de datos (SQLite para desarrollo local; usar postgresql://... en producción)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
NEXTAUTH_URL="http://localhost:3000"

# Integración Nubox
# NUBOX_MODE=mock  -> usa datos de ejemplo, no llama a Nubox (útil para demo)
# NUBOX_MODE=live  -> usa NuboxApiClient contra la API real de Nubox
NUBOX_MODE="mock"
NUBOX_API_BASE_URL="https://api.nubox.com"
